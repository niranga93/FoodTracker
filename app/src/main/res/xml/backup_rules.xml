<?xml version="1.0" encoding="utf-8"?>
<!--
   Android's own backup on Android 11 and earlier. Same rule as data_extraction_rules.xml:
   the Keystore-encrypted Gemini keys can't be decrypted on another phone, so they stay out.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="gemini_user_keys.xml" />
</full-backup-content>
