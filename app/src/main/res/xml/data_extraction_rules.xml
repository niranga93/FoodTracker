<?xml version="1.0" encoding="utf-8"?>
<!--
   Android's own backup and device-to-device transfer (Android 12 and later).
   The Gemini keys are left out: they are encrypted with a Keystore key that never leaves
   this phone, so a copy could not be decrypted anywhere else.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gemini_user_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gemini_user_keys.xml" />
    </device-transfer>
</data-extraction-rules>
