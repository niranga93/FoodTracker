<?xml version="1.0" encoding="utf-8"?>
<!--
   Android's own backup and device-to-device transfer (Android 12 and later).
   Left out:
   - gemini_user_keys: encrypted with a Keystore key that never leaves this phone, so a copy
     could not be decrypted anywhere else.
   - health, insights: values derived from Health Connect (basal metabolic rate, sync records,
     tips based on sleep, heart rate and blood pressure). The privacy policy promises these stay
     on the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gemini_user_keys.xml" />
        <exclude domain="sharedpref" path="health.xml" />
        <exclude domain="sharedpref" path="insights.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gemini_user_keys.xml" />
        <exclude domain="sharedpref" path="health.xml" />
        <exclude domain="sharedpref" path="insights.xml" />
    </device-transfer>
</data-extraction-rules>
